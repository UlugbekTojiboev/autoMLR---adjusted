\docType{package}
\name{autoMLR-package}
\alias{autoMLR-package}
\alias{autoMLR}
\title{autoMLR: Interactive AutoML data cleaning}
\description{
The \code{autoMLR} package wraps the original Shiny data-cleaning project in a
reusable R package. It exposes a documented R6 transformation pipeline, Rcpp
imputation helpers, vectorised transformations, and a Shiny dashboard launcher.
}
\seealso{
\code{\link{run_app}}, \code{\link{Pipeline}}, \code{\link{replay_steps}}
}
\keyword{internal}
